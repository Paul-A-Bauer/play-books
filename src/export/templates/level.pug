doctype 1.1
html(xmlns='http://www.w3.org/1999/xhtml', xml:lang='en')
  head
    title {{TITLE}}
  body
    h3 {{TITLE}}
    table(style='border-collapse:collapse;margin:auto')
      each row, y in state.L().grid
        tr
          each id, x in row
            - const t = state.sprite(state.tileAt(x, y))
            td(style='width:2em;height:2em;text-align:center;padding:0;background:' + (t.color || '#ddd'))
              if x === state.x && y === state.y
                | #{state.cfg().player}
              else if t.img
                img(src=t.img, alt='', style='width:2em;height:2em')
              else
                | #{t.glyph || ''}
    p #{state.msg}
    p #{JSON.stringify(state.vars)}
    if state.over
      h1 YOU #{state.over.toUpperCase()}
      p #[a(href=goto('level0', (s) => s.reset())) Play again]
    else if state.actions().length === 0
      p No moves possible. #[a(href=goto('level0', (s) => s.reset())) Restart]
    else
      p
        - for (const a of state.actions())
          a(href=goto(state.next(a.dx, a.dy), (s) => s.move(a.dx, a.dy))) #{a.label}
          | &#160;&#160;
