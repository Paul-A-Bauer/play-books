doctype 1.1
html(xmlns='http://www.w3.org/1999/xhtml', xml:lang='en')
  head
    title {{TITLE}}
  body
    h3 {{TITLE}}
    - const map = state.L().grid.map((row, y) => row.map((id, x) => { const isPlayer = x === state.x && y === state.y; const t = state.sprite(isPlayer ? 'player' : state.tileAt(x, y)); const glyph = t.glyph; return /^[\x20-\x7e]$/.test(glyph) ? glyph : ({ player: '@', floor: '.', wall: '#', key: 'k', door: 'D', exit: '>', goal: '*' }[t.id] || (t.id.match(/[A-Za-z0-9]/) || ['?'])[0]); }).join(''))
    pre= map.join('\n')
    p #{state.msg}
    p #{JSON.stringify(state.vars)}
    if state.over
      h1 YOU #{state.over.toUpperCase()}
      p(align='center') #[a(href=goto('level0', (s) => s.reset())) Play again]
    else if state.actions().length === 0
      p(align='center') No moves possible. #[a(href=goto('level0', (s) => s.reset())) Restart]
    else
      each a in state.actions()
        - const label = state.L().mode === 'platformer' && a.dy < 0 ? (a.dx < 0 ? 'Jump left' : a.dx > 0 ? 'Jump right' : 'Jump') : a.dx < 0 ? 'Left' : a.dx > 0 ? 'Right' : a.dy < 0 ? 'Up' : 'Down'
        p(align='center') #[a(href=goto(state.next(a.dx, a.dy), (s) => s.move(a.dx, a.dy))) #{label}]
